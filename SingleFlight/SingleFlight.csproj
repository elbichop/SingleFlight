<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageIcon>SingleFlight_.PNG</PackageIcon>
		<!-- Framework -->
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>

		<!-- C# -->
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet -->
		<PackageId>SingleFlight.Net</PackageId>
		<Version>1.1.0</Version>
		<Authors>Manuel Jimenez Lopez</Authors>
		<Description>
			Lightweight async single-flight implementation for .NET that coalesces concurrent operations by key and prevents duplicate work.
		</Description>
		<PackageTags>singleflight;async;concurrency;deduplication;cache;http</PackageTags>
		
		<!-- Notes -->
		<PackageReleaseNotes>
			Improved cancellation semantics, multi-targeting for .NET 8, .NET 9 and .NET 10, and documentation improvements.
		</PackageReleaseNotes>
		
		<!-- README / License -->
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

		<!-- Repository -->
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/elbichop/SingleFlight.git</RepositoryUrl>

		<!-- Source Link / Debugging -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- XML Documentation -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Package on Release -->
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md"
			  Pack="true"
			  PackagePath="\" />

		<None Include="..\LICENSE"
			  Pack="true"
			  PackagePath="\" />
		
		<None Include="..\SingleFlight_.PNG"
			  Pack="true"
			  PackagePath="\" />
	</ItemGroup>

</Project>